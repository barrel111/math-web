[
  {
    "name": "parens ordinary",
    "command": "parens",
    "tex": "\\parens{x}",
    "expected": "( x )"
  },
  {
    "name": "parens automatic",
    "command": "parens",
    "tex": "\\parens*{\\frac{x}{2}}",
    "expected": "\\mathopen{\\left( \\frac{x}{2}\\right)}\\mathclose{}"
  },
  {
    "name": "parens sized",
    "command": "parens",
    "tex": "\\parens[\\Big]{x}",
    "expected": "\\Bigl( x \\Bigr)"
  },
  {
    "name": "bracks ordinary",
    "command": "bracks",
    "tex": "\\bracks{x}",
    "expected": "[ x ]"
  },
  {
    "name": "bracks automatic",
    "command": "bracks",
    "tex": "\\bracks*{\\frac{x}{2}}",
    "expected": "\\mathopen{\\left[ \\frac{x}{2}\\right]}\\mathclose{}"
  },
  {
    "name": "bracks sized",
    "command": "bracks",
    "tex": "\\bracks[\\Big]{x}",
    "expected": "\\Bigl[ x \\Bigr]"
  },
  {
    "name": "braces ordinary",
    "command": "braces",
    "tex": "\\braces{x}",
    "expected": "\\lbrace x \\rbrace"
  },
  {
    "name": "braces automatic",
    "command": "braces",
    "tex": "\\braces*{\\frac{x}{2}}",
    "expected": "\\mathopen{\\left\\lbrace \\frac{x}{2}\\right\\rbrace}\\mathclose{}"
  },
  {
    "name": "braces sized",
    "command": "braces",
    "tex": "\\braces[\\Big]{x}",
    "expected": "\\Bigl\\lbrace x \\Bigr\\rbrace"
  },
  {
