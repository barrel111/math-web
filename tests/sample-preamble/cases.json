  },
  {
    "name": "set Big",
    "command": "set",
    "tex": "\\set[\\Big]{x}{x\\in\\R}",
    "expected": "\\Bigl\\lbrace x\\;\\Big\\vert\\;x\\in\\mathbb{R}\\Bigr\\rbrace"
  },
  {
    "name": "set bigg",
    "command": "set",
    "tex": "\\set[\\bigg]{x}{x\\in\\R}",
    "expected": "\\biggl\\lbrace x\\;\\bigg\\vert\\;x\\in\\mathbb{R}\\biggr\\rbrace"
  },
  {
    "name": "set Bigg",
    "command": "set",
    "tex": "\\set[\\Bigg]{x}{x\\in\\R}",
    "expected": "\\Biggl\\lbrace x\\;\\Bigg\\vert\\;x\\in\\mathbb{R}\\Biggr\\rbrace"
  },
  {
    "name": "nested delimiters",
    "command": "norm",
    "tex": "\\norm*{\\parens[\\Big]{x}+\\abs{y}}",
    "expected": "\\mathopen{\\left\\lVert\\Bigl(x\\Bigr)+\\lvert y\\rvert\\right\\rVert}\\mathclose{}"
  },
  {
    "name": "nested set sizes",
    "command": "set",
    "tex": "\\set[\\Big]{\\set[\\big]{x}{x>0}}{x<1}",
    "expected": "\\Bigl\\lbrace\\bigl\\lbrace x\\;\\big\\vert\\;x>0\\bigr\\rbrace\\;\\Big\\vert\\;x<1\\Bigr\\rbrace"
  },
