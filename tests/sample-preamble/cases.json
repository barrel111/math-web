  {
    "name": "set ordinary",
    "command": "set",
    "tex": "\\set{x}{x\\in\\R}",
    "expected": "\\lbrace x\\;\\vert\\;x\\in\\mathbb{R}\\rbrace"
  },
  {
    "name": "set automatic",
    "command": "set",
    "tex": "\\set*{x}{x\\in\\R}",
    "expected": "\\mathopen{\\left\\lbrace x\\;\\middle\\vert\\;x\\in\\mathbb{R}\\right\\rbrace}\\mathclose{}"
  },
  {
    "name": "set big",
    "command": "set",
    "tex": "\\set[\\big]{x}{x\\in\\R}",
